          "name": "01 Listar cardápio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"só itens disponíveis, com preço\", () => { const j = pm.response.json(); pm.expect(j.items.length).to.be.above(0); j.items.forEach(i => pm.expect(i.preco).to.be.a(\"number\")); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/unidades/1/cardapio?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
