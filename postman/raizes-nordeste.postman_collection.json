                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.sendRequest({url: pm.environment.get(\"baseUrl\") + \"/fidelidade/saldo\", method: \"GET\", header: {\"Authorization\": \"Bearer \" + pm.environment.get(\"tokenCliente\")}}, (err, res) => {",
                  "  pm.test(\"saldo de pontos > 0\", () => pm.expect(res.json().pontos).to.be.above(0));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/fidelidade/consentimentos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
